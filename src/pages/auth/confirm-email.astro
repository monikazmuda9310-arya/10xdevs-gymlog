---
import Layout from "@/layouts/Layout.astro";

// No branch. `/api/auth/signup` sends the caller here only when `signUp` returned no session,
// which is precisely when a confirmation email is on its way. The previous condition keyed off
// `import.meta.env.DEV` — i.e. build mode, not the Supabase project's actual setting — so every
// production build told new users to check an inbox that received nothing.
const content = {
  emoji: "📧",
  heading: "Check your email",
  description: "We've sent a confirmation link to your email address. Click it to activate your account.",
  linkText: "Back to sign in",
};
---

<Layout title={content.heading}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        {content.heading}
      </h1>
      <p class="mb-6 text-blue-100/80">{content.description}</p>
      <a href="/auth/signin" class="text-sm text-purple-300 hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>

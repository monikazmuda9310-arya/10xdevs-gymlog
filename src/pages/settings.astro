---
import Layout from "@/layouts/Layout.astro";
import { PreferencesForm } from "@/components/settings/PreferencesForm";
import { DeleteAccountPanel } from "@/components/settings/DeleteAccountPanel";
import { getProfile } from "@/lib/services/profiles";
import { accountFootprint, type AccountFootprint } from "@/lib/services/accounts";
import { supportedTimeZones } from "@/lib/services/timezones";
import type { EstimationFormula, WeightUnit } from "@/types";

// FR-016, FR-022, US-03. The three preferences the account has always owned in the database and has
// never been able to change.
//
// **THE TIMEZONE `<option>` ELEMENTS ARE EMITTED HERE, BY ASTRO, AND NEVER BY THE ISLAND.** There
// are 418 of them (measured in real workerd, see `timezones.ts`) — roughly 17 KB of HTML before
// compression and ZERO bytes of JavaScript, provided the list never crosses into a prop. Astro
// serialises island props into an `<astro-island props="…">` attribute, so handing the list to
// `PreferencesForm` would ship every zone name to the browser for a control that needs no
// JavaScript. The `<select>` is slotted into the island instead; the island reads its value on
// submit. See § Critical Implementation Details in this slice's plan.

const { user, supabase } = Astro.locals;

// The same defaults the column carries, used only as the shape of a failed read — never rendered as
// though they were the account's own choices. `loadFailed` is what keeps those two apart.
let timezone = "Europe/Warsaw";
let weightUnit: WeightUnit = "kg";
let estimationFormula: EstimationFormula = "brzycki";
let loadFailed = false;

if (supabase && user) {
  try {
    const profile = await getProfile(supabase, user.id);
    if (profile) {
      timezone = profile.timezone;
      weightUnit = profile.weight_unit;
      estimationFormula = profile.estimation_formula;
    } else {
      // **A missing row is a failed load, not an empty one**, and this branch is what makes the
      // comment above true. `getProfile` uses `maybeSingle()`, so an absent profile comes back as
      // `null` WITHOUT throwing — which would otherwise fall through and render the defaults as
      // though the account had chosen them, the exact confusion `loadFailed` exists to prevent.
      // It should be unreachable: a trigger creates a profile for every account and there is no
      // delete path. If it happens, something is wrong that saving over would not fix.
      loadFailed = true;
      // eslint-disable-next-line no-console -- deliberate server-side diagnostic
      console.error("settings: no profile row for", user.id);
    }
  } catch (error) {
    // Without this branch a failed read renders the defaults as if the user had chosen them, and
    // the first Save would write them over whatever the account really had. Same silent-failure
    // class the records and workout lists guard against.
    loadFailed = true;
    // eslint-disable-next-line no-console -- deliberate server-side diagnostic
    console.error("settings: profile read failed", error);
  }
}

// What the deletion dialog names. Read HERE rather than by the island, because the island has no
// Supabase client and giving it one would ship the whole library to the browser for three integers.
// **Three integers are a legitimate island prop; the 418-entry timezone list above is not** — the
// rule is about the size of what crosses the wire, not about props being forbidden.
//
// **A failed read stays `null` and is never coerced to zeros.** `accountFootprint` returns null when
// any of the three counts fails, and the dialog says so — a zero would read as "you have nothing to
// lose" at the exact moment that is the question being asked.
let footprint: AccountFootprint | null = null;
if (supabase && user) {
  try {
    footprint = await accountFootprint(supabase, user.id);
  } catch (error) {
    // eslint-disable-next-line no-console -- deliberate server-side diagnostic
    console.error("settings: account footprint read failed", error);
  }
}

const timeZones = supportedTimeZones();

// A stored zone this runtime does not recognise — a profile written before an ICU upgrade dropped
// the name, or a column edited by hand. Rare, and it has exactly one honest presentation.
//
// **It is NOT offered as a selectable option**, and the first version of this page got that wrong.
// The endpoint validates against this same list, so offering the stored value back would produce a
// `400 timezone_unknown` for a value the page itself supplied — and because the payload is a full
// replacement, it would block the unit and formula changes with it. That is the two-sources failure
// § Critical Implementation Details of this slice's plan forbids by name, arriving through the one
// door nobody was watching.
//
// So the placeholder below carries `value=""`, which the schema answers with `timezone_required`
// ("Choose the timezone your training week runs in") — an accurate, actionable message — and the
// sentence beside the control says what happened. The account is told what is stored rather than
// being shown a substitute zone as though it had chosen it, which is the same stance `loadFailed`
// takes above.
const zoneIsKnown = timeZones.includes(timezone);
---

<Layout title="Settings">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-2xl py-8">
      <header class="mb-2 flex items-baseline justify-between gap-4">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Settings
        </h1>
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">Dashboard</a>
      </header>
      <p class="mb-6 text-sm text-blue-100/50">
        How weights are entered, how a one-rep max is estimated, and which week your training is measured in.
      </p>

      {
        loadFailed ? (
          <p class="rounded-lg border border-red-400/30 bg-red-900/30 px-4 py-6 text-center text-red-200">
            Your preferences could not be loaded, so this form is not shown — saving now would overwrite settings we
            cannot see. Please refresh; if it keeps happening, your account record may need attention.
          </p>
        ) : (
          <PreferencesForm
            client:load
            timezone={timezone}
            weightUnit={weightUnit}
            estimationFormula={estimationFormula}
          >
            <label for="settings-timezone" class="sr-only">
              Training week timezone
            </label>
            {!zoneIsKnown && (
              <p class="mb-2 rounded-lg border border-amber-400/30 bg-amber-500/10 px-3 py-2 text-xs text-amber-100">
                Your saved timezone <strong>{timezone}</strong> is not one this version recognises, so dates fall back
                to UTC — a new workout currently defaults to today in UTC. Pick a replacement below and save.
              </p>
            )}
            <select
              id="settings-timezone"
              name="timezone"
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
            >
              {/* Empty value and `disabled`: it names what is stored without ever being submittable.
                  See the note above `zoneIsKnown` for why offering the stored value would be wrong. */}
              {!zoneIsKnown && (
                <option value="" disabled selected class="bg-slate-900">
                  {timezone} — not recognised, choose one below
                </option>
              )}
              {timeZones.map((zone) => (
                <option value={zone} selected={zone === timezone} class="bg-slate-900">
                  {zone}
                </option>
              ))}
            </select>
          </PreferencesForm>
        )
      }

      {
        /* **Outside the ternary above, deliberately.** `loadFailed` replaces the preferences form
          when the profile read fails — and somebody whose account record needs attention is more
          likely to want this control, not less. Moving it inside is the one mistake
          tests/render/settings-delete-panel.test.ts exists to catch, and it does: mutation (f) of
          this slice's Phase 3 protocol reddens exactly the failed-profile case. */
      }
      <DeleteAccountPanel client:load footprint={footprint} />
    </div>
  </div>
</Layout>

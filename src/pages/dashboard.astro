---
import Layout from "@/layouts/Layout.astro";
import { weeklyBreakdown, weeklyTonnage, type WeekTonnage } from "@/lib/services/tonnage";
import type { WeekBreakdown } from "@/lib/services/tonnage-breakdown";
import { apportionedFigures, tonnageFigure } from "@/lib/services/tonnage-display";
import { MUSCLE_GROUP_LABELS } from "@/lib/validation/exercise";
import type { MuscleGroup, WeightUnit } from "@/types";

const { user, supabase } = Astro.locals;

// Deliberately unfiltered: the point of this read is that RLS returns exactly one row — the
// signed-in account's own. maybeSingle(), not single(), so a missing row renders as a missing
// value rather than a 500.
//
// S-07 widened it from `timezone` to `timezone, weight_unit` and changed nothing else. The tonnage
// figures need the zone to know which weeks to compare and the unit to print in, and taking both
// from this one read keeps F-03's demonstration intact, keeps the page to a single profile query,
// and keeps `getProfile` — whose `.eq("id", …)` would destroy the demonstration — out of it.
const { data: profile, error } = (await supabase?.from("profiles").select("timezone, weight_unit").maybeSingle()) ?? {
  data: null,
  error: null,
};

if (error) {
  // Without this, a failed read is indistinguishable from an absent row: both render the fallback.
  // That is the silent-failure class AGENTS.md § Cloudflare traps warns about, arriving by a
  // second door — a revoked grant or a schema-cache miss would look like "no data yet".
  // eslint-disable-next-line no-console
  console.warn(`dashboard: profile read failed (${error.code}): ${error.message}`);
}

// **A missing profile is a failed load for the tonnage figures, not an empty one.** Before S-07 a
// null profile only cost this page a sentence about the training week. Now it means the unit and the
// zone are both unknown — and printing a figure under a defaulted unit, or a week computed in UTC
// for somebody who is not in it, is the defect the S-06 implementation review found in
// `settings.astro` and pinned at `tests/render/settings-island.test.ts`: never present a default as
// though it were the account's own choice.
let tonnage: { current: WeekTonnage; previous: WeekTonnage } | null = null;
let tonnageFailed = !profile;

if (supabase && user && profile) {
  try {
    tonnage = await weeklyTonnage(supabase, user.id, profile.timezone);
  } catch (readError) {
    // The service throws rather than answering zero, because an emitted zero is a positive claim —
    // "you did no work this week" — and that is the wrong sentence when the database is unreachable.
    // The throw has to be caught HERE: an Astro frontmatter that throws produces a 500, not a page.
    tonnageFailed = true;
    // eslint-disable-next-line no-console -- deliberate server-side diagnostic
    console.error("dashboard: weekly tonnage read failed", readError);
  }
}

const weightUnit: WeightUnit = profile?.weight_unit ?? "kg";

// **A third read, and it fails on its own** (FR-018, FR-019, US-03). Two things about this block are
// deliberate and read as inconsistencies otherwise:
//
// 1. It runs only when the tonnage read SUCCEEDED. `foldBreakdown` reconciles the breakdown against
//    the week total the screen is already printing, so with no total there is nothing to reconcile
//    against — and a breakdown shown beside a failure sentence would be a figure nobody could check.
// 2. It carries its OWN flag rather than setting `tonnageFailed`. This follows S-05's
//    `impact_unavailable` ruling — the reliable thing stays on screen, the unknown one says it is
//    unknown — rather than S-07's page-level flag. The two totals are S-07's proven feature and must
//    survive a breakdown failure; `tests/render/dashboard-tonnage.test.ts` asserts exactly that.
//
// The throw is caught HERE for the reason the tonnage one is: an Astro frontmatter that throws
// produces a 500, not a page.
let breakdown: WeekBreakdown | null = null;
let breakdownFailed = false;

if (supabase && user && tonnage && !tonnageFailed) {
  try {
    breakdown = await weeklyBreakdown(supabase, user.id, tonnage.current, tonnage.current.kilograms);
  } catch (readError) {
    breakdownFailed = true;
    // eslint-disable-next-line no-console -- deliberate server-side diagnostic
    console.error("dashboard: weekly breakdown read failed", readError);
  }
}

const weekTotalKg = tonnage?.current.kilograms ?? 0;

// **Rounded TOGETHER against the week total, never one row at a time.** `tonnage-display.ts` states
// what that costs — a row can read one whole unit away from its own independently rounded value —
// and who decided it. Two calls, because each list sums to the whole week on its own: every exercise
// belongs to exactly one muscle group. The two weekly totals above keep using `tonnageFigure`.
const groupFigures = apportionedFigures(
  breakdown?.groups.map((group) => group.kilograms) ?? [],
  weekTotalKg,
  weightUnit,
);
const exerciseFigures = apportionedFigures(
  breakdown?.exercises.map((exercise) => exercise.kilograms) ?? [],
  weekTotalKg,
  weightUnit,
);

/** `Unattributed` is a claim about tonnage this account can no longer name — see the row's own note. */
const groupLabel = (group: MuscleGroup | null): string =>
  group === null ? "Unattributed" : MUSCLE_GROUP_LABELS[group];

/**
 * The bar is presentation, and the number on the row is the tonnage — no percentage is printed.
 * Guarded against a zero total, which is an ordinary week (no sets, or planks only) and not an error.
 */
const barWidth = (kilograms: number): string => {
  const share = weekTotalKg > 0 ? (kilograms / weekTotalKg) * 100 : 0;
  return `${String(Math.max(0, Math.min(100, share)))}%`;
};

// One wording, used beside the weekly totals AND on a group row. The distinction it carries is the
// one `hasSets` exists for: a week or a group of planks did train, it just moved no external load.
const NO_EXTERNAL_LOAD = "Sets logged, no external load";
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    {/* The card was shrink-to-fit until S-08. Six group rows and an exercise list need a width. */}
    <div
      class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      {
        /*
        The raw timezone string used to be printed here on its own, which told the reader nothing
        about what it governed. It names the training week now, and the link is what makes the
        preference reachable — NOT `Topbar.astro`, which is imported only by `Welcome.astro` and so
        renders on the public landing page and nowhere else.
      */
      }
      <p class="text-blue-100/80">
        {
          profile
            ? `Your training week runs Monday to Sunday in ${profile.timezone}.`
            : "Your training week timezone is not set yet."
        }
      </p>
      {
        /*
        FR-017. Two figures, and three states — but the failure state is per PAGE while "no sets" is
        per WEEK, because US-03's criterion is about a week and not about a screen. The commonest
        real state is the first week somebody logs: this week has work, last week has none. A
        page-level model would put that in the "figures" branch and leave last week's 0 bare, which
        is the blank the criterion forbids.
      */
      }
      <section class="mt-6 border-t border-white/10 pt-5">
        <h2 class="mb-3 text-xs tracking-wide text-blue-100/50 uppercase">Tonnage</h2>
        {
          tonnageFailed || !tonnage ? (
            <p class="rounded-lg border border-red-400/30 bg-red-900/30 px-4 py-4 text-sm text-red-200">
              Your weekly tonnage could not be loaded. Please refresh; if it keeps happening, the database may be
              unreachable.
            </p>
          ) : (
            <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              {[
                { label: "This week", week: tonnage.current },
                { label: "Last week", week: tonnage.previous },
              ].map(({ label, week }) => (
                <div class="rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-left">
                  <dt class="text-xs text-blue-100/50">{label}</dt>
                  <dd class="mt-1">
                    <span class="text-2xl font-semibold text-purple-200">
                      {tonnageFigure(week.kilograms, weightUnit)}
                    </span>
                    <span class="ml-1 text-sm text-purple-200/70">{weightUnit}</span>
                    {/*
                      The zero is still shown — US-03 requires it — with a sentence saying why, so it
                      cannot be read as "the product lost my training". `hasSets`, not the figure,
                      decides: a week of planks has sets and rounds to 0, and must not be told it was
                      a rest week.
                    */}
                    {!week.hasSets ? (
                      <span class="mt-1 block text-xs text-blue-100/50">No sets logged {label.toLowerCase()}</span>
                    ) : (
                      /*
                        S-07 left this half of the distinction unwritten, and
                        `tonnage-display.test.ts:46-51` already describes it as though it existed: a
                        week of planks rendered a bare `0` and read as a rest week. A sentence, never
                        a change to the figure — the figures themselves are S-07's and are untouched.
                      */
                      week.kilograms === 0 && (
                        <span class="mt-1 block text-xs text-blue-100/50">{NO_EXTERNAL_LOAD}</span>
                      )
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </section>

      {
        /*
        FR-018 and FR-019. Static HTML, no island: a breakdown has no interaction, and the render
        suite's no-island assertion is what keeps it that way.

        **The rows must not reuse `text-2xl font-semibold text-purple-200`** — that class is how
        `tests/render/dashboard-tonnage.test.ts` counts the figures on this page, and it expects
        exactly two of them, the two weekly totals.
      */
      }
      <section class="mt-6 border-t border-white/10 pt-5 text-left">
        <h2 class="mb-3 text-center text-xs tracking-wide text-blue-100/50 uppercase">Where this week went</h2>
        {
          breakdownFailed || !breakdown ? (
            <p class="rounded-lg border border-amber-400/30 bg-amber-900/20 px-4 py-4 text-center text-sm text-amber-100">
              Your breakdown could not be loaded. The totals above are unaffected.
            </p>
          ) : (
            <div class="space-y-5">
              <div>
                <h3 class="mb-2 text-xs tracking-wide text-blue-100/40 uppercase">By muscle group</h3>
                <ul class="space-y-2">
                  {breakdown.groups.map((group, index) => (
                    <li class="rounded-lg border border-white/10 bg-white/5 px-4 py-2">
                      <div class="flex items-baseline justify-between gap-3">
                        <span class="text-sm text-blue-100/80">{groupLabel(group.group)}</span>
                        <span class="text-sm font-medium text-purple-200">
                          {groupFigures[index]}
                          <span class="ml-1 text-xs text-purple-200/70">{weightUnit}</span>
                        </span>
                      </div>
                      <div aria-hidden="true" class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-white/10">
                        <div
                          class="h-full rounded-full bg-purple-300/70"
                          style={`width: ${barWidth(group.kilograms)}`}
                        />
                      </div>
                      {/* `hasSets`, not the figure, decides — the same distinction the weekly totals
                          carry. A group of planks has sets and no external load; an untrained group
                          has neither, and the two must not read the same. */}
                      {!group.hasSets ? (
                        <p class="mt-1 text-xs text-blue-100/40">No sets</p>
                      ) : (
                        group.kilograms === 0 && <p class="mt-1 text-xs text-blue-100/40">{NO_EXTERNAL_LOAD}</p>
                      )}
                      {group.group === null && (
                        <p class="mt-1 text-xs text-blue-100/40">
                          An exercise behind this tonnage is no longer readable by your account.
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h3 class="mb-2 text-xs tracking-wide text-blue-100/40 uppercase">By exercise</h3>
                {breakdown.exercises.length === 0 ? (
                  <p class="text-xs text-blue-100/40">No exercises logged this week.</p>
                ) : (
                  <ul class="space-y-1">
                    {breakdown.exercises.map((exercise, index) => (
                      <li class="flex items-baseline justify-between gap-3 rounded-lg border border-white/10 bg-white/5 px-4 py-2">
                        {/* Not the bare `Unattributed` the group row carries. The two rows make
                            different claims — one is tonnage belonging to no group, the other is a
                            single exercise this account cannot read — and giving them the same label
                            would put the same word on the same screen twice meaning two things. */}
                        <span class="text-sm text-blue-100/80">{exercise.name ?? "Unattributed exercise"}</span>
                        <span class="text-sm font-medium text-purple-200">
                          {exerciseFigures[index]}
                          <span class="ml-1 text-xs text-purple-200/70">{weightUnit}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          )
        }
      </section>

      <p class="mt-6 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <p class="mt-4">
        <a href="/workouts" class="text-sm text-purple-300 hover:underline">Log a workout →</a>
      </p>
      <p class="mt-2">
        <a href="/exercises" class="text-sm text-purple-300 hover:underline">Browse exercises →</a>
      </p>
      <p class="mt-2">
        <a href="/records" class="text-sm text-purple-300 hover:underline">See your records →</a>
      </p>
      <p class="mt-2">
        <a href="/settings" class="text-sm text-purple-300 hover:underline">Units, formula and timezone →</a>
      </p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>

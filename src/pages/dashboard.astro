---
import Layout from "@/layouts/Layout.astro";

const { user, supabase } = Astro.locals;

// Deliberately unfiltered: the point of this read is that RLS returns exactly one row — the
// signed-in account's own. maybeSingle(), not single(), so a missing row renders as a missing
// value rather than a 500.
const { data: profile, error } = (await supabase?.from("profiles").select("timezone").maybeSingle()) ?? {
  data: null,
  error: null,
};

if (error) {
  // Without this, a failed read is indistinguishable from an absent row: both render the fallback.
  // That is the silent-failure class AGENTS.md § Cloudflare traps warns about, arriving by a
  // second door — a revoked grant or a schema-cache miss would look like "no data yet".
  // eslint-disable-next-line no-console
  console.warn(`dashboard: profile read failed (${error.code}): ${error.message}`);
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="text-blue-100/80">
        Training week: <span class="font-semibold text-white">{profile?.timezone ?? "not set"}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>

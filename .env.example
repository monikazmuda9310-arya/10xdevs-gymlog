# GymLog runs against two hosted Supabase projects. There is no local database stack.
# Copy this file to .env (and the first two keys to .dev.vars). Never commit real values.

# --- gymlog (production) — the project the deployed Worker serves ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=###
# Publishable key (new format) or legacy anon key. Never the service_role key.
SUPABASE_KEY=###
# Session-mode pooler URI, copied from the dashboard's Connect dialog — never constructed.
# Shape: postgresql://postgres.<project-ref>:<percent-encoded-password>@<region-pooler-host>:5432/postgres
# Port 5432 (session mode), not 6543: transaction mode cannot run DDL.
# Used only by `npm run db:push` / `db:status` / `db:types`. Never a Worker secret.
SUPABASE_DB_URL=###

# Personal access token from https://supabase.com/dashboard/account/tokens — account-wide scope.
# Used ONLY by `npm run db:types`: the CLI generates types through the Management API because
# `gen types --db-url` needs a container runtime and there is none on this machine.
# Never put this in .dev.vars, in CI, or in a Worker secret.
SUPABASE_ACCESS_TOKEN=###

# --- gymlog-test — the project CI and the integration check write to ---
SUPABASE_TEST_URL=###
SUPABASE_TEST_KEY=###
# Same session-mode pooler shape as SUPABASE_DB_URL, for the test project.
SUPABASE_TEST_DB_URL=###

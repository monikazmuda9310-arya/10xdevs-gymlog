# build output
dist/

# generated types
.astro/

# eslint cache, written by the edit-time hook in .claude/settings.json
.eslintcache

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# vitest.middleware.config.ts points `vite.envDir` at this directory BECAUSE it holds no
# credentials: Vite's loadEnv reads `.env*` from the env directory, so a file here would silently
# re-aim the middleware project at whatever it names. The config throws at load time if one appears;
# this line is the second defence, so an accidental file can never be committed either.
tests/middleware/no-env/.env*

# playwright output (`npm run test:e2e`)
test-results/
playwright-report/
blob-report/
.playwright/

# cloudflare
.dev.vars
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

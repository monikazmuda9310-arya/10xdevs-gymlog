{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | tr -d '\\r' | { read -r f; case \"$f\" in *.ts|*.tsx|*.astro) npx eslint --cache --cache-location .eslintcache \"$f\" || exit 2;; esac; }",
            "timeout": 120,
            "asyncRewake": true,
            "statusMessage": "eslint on the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if git status --porcelain -- '*.ts' '*.tsx' '*.astro' | grep -q .; then npm run typecheck || exit 2; fi",
            "timeout": 300,
            "asyncRewake": true,
            "statusMessage": "astro check across the project"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.production)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler pages deploy:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)"
    ],
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git show:*)",
      "Bash(git restore:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ]
  }
}
